# Fastfile for FTI Coach
#
# Lanes:
#   fastlane ios beta       - bump build number, build, upload to TestFlight
#   fastlane ios screenshots - capture App Store screenshots (snapshot/XCUITest)
#   fastlane ios release    - bump marketing version, capture screenshots,
#                             build, upload and submit for App Store review
#
# Required environment variables (set as GitHub Actions secrets in CI):
#   ASC_KEY_ID                    App Store Connect API key ID
#   ASC_ISSUER_ID                 App Store Connect API issuer ID
#   ASC_KEY_CONTENT               Contents of the .p8 API key file
#   MATCH_PASSWORD                Passphrase used to encrypt the match repo
#   SCREENSHOT_EMAIL              Demo driver account used to sign in for screenshots
#   SCREENSHOT_PASSWORD           Password for the demo driver account
#
# The certificates repo is cloned over SSH; in CI a read-only deploy key is
# loaded into ssh-agent by the workflows before fastlane runs.

require "fileutils"

default_platform(:ios)

APP_IDENTIFIER = "com.foxytravel.fticoach"
TEAM_ID = "97H8939ZRR"
XCODEPROJ = "ios/fti_coach.xcodeproj"
WORKSPACE = "ios/fti_coach.xcworkspace"
SCHEME = "fti_coach"
TARGET = "fti_coach"

platform :ios do
  private_lane :asc_api_key do
    # ASC_KEY_CONTENT is the base64-encoded .p8 file. Base64 is used so the
    # PEM newlines survive being stored in a GitHub secret / env var — raw
    # multiline keys are easily mangled, which surfaces as
    # "invalid curve name (OpenSSL::PKey::ECError)".
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
    )
  end

  # Fetches signing certs/profiles from the match repo and switches the
  # project to manual signing with the fetched profile.
  private_lane :prepare_signing do |options|
    setup_ci if is_ci

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: is_ci,
      api_key: options[:api_key],
    )

    profile_name =
      lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_IDENTIFIER]

    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: TEAM_ID,
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: [TARGET],
    )
  end

  # Sets the build number to (latest TestFlight build number + 1) so every CI
  # run produces a strictly increasing build number without requiring commits.
  private_lane :bump_build_number do |options|
    latest = latest_testflight_build_number(
      api_key: options[:api_key],
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 18,
    )
    increment_build_number_in_xcodeproj(
      xcodeproj: XCODEPROJ,
      build_number: (latest + 1).to_s,
      target: TARGET,
    )
  end

  private_lane :build_release_ipa do
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      output_directory: "build",
      output_name: "fti_coach.ipa",
    )
  end

  # Sets the marketing version, either explicitly or by bumping, and returns
  # the resulting version string.
  private_lane :apply_version_bump do |options|
    if options[:version] && !options[:version].to_s.empty?
      increment_version_number_in_xcodeproj(
        xcodeproj: XCODEPROJ,
        version_number: options[:version],
        target: TARGET,
      )
    else
      increment_version_number_in_xcodeproj(
        xcodeproj: XCODEPROJ,
        bump_type: options[:bump] || "patch",
        target: TARGET,
      )
    end

    get_version_number_from_xcodeproj(
      xcodeproj: XCODEPROJ,
      target: TARGET,
    )
  end

  # Commits the version bump and tags it. Only the marketing version should be
  # in this commit — when run from CI's publish job the checkout is clean, so
  # the signing settings and build number that the build job wrote to its own
  # working copy are never committed.
  private_lane :tag_release do |options|
    version = options[:version]

    if is_ci
      sh("git", "config", "user.name", "github-actions[bot]")
      sh("git", "config", "user.email", "github-actions[bot]@users.noreply.github.com")
    end
    sh("git", "add", "../#{XCODEPROJ}/project.pbxproj")
    sh("git", "commit", "-m", "chore: release v#{version} [skip ci]")
    add_git_tag(tag: "v#{version}")
    push_to_git_remote(tags: true)
  end

  desc "Create (or repair) the App Store distribution certificate and"
  desc "provisioning profile in the match repo. Must run on macOS — use the"
  desc "'iOS Seed Certificates' workflow; the deploy key needs write access."
  lane :certs do
    api_key = asc_api_key
    setup_ci if is_ci

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: false,
      api_key: api_key,
    )
  end

  desc "Build the app and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key
    prepare_signing(api_key: api_key)
    bump_build_number(api_key: api_key)
    build_release_ipa

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
    )
  end

  # snapshot resolves the device by name against the simulators that already
  # exist in `xcrun simctl`; it will not create a missing one and instead aborts
  # with "No device found named '...'". Fresh Xcode installs and GitHub's
  # macos-26 runners do not reliably ship every iPhone, so make sure the device
  # the Snapfile names actually exists before snapshot runs.
  private_lane :ensure_screenshot_device do
    device_name = ENV["SNAPSHOT_DEVICE"] || "iPhone 17 Pro Max"

    unless `xcrun simctl list devices available`.lines.any? { |line| line.include?(device_name) }
      UI.important("Simulator '#{device_name}' not found; creating it...")

      # Device type id, e.g. "iPhone 17 Pro Max" ->
      # "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro-Max".
      device_type_id = `xcrun simctl list devicetypes`
        .lines
        .find { |line| line.include?(device_name) }
        .to_s[/com\.apple\.CoreSimulator\.SimDeviceType\.[^)]*/, 0]
      UI.user_error!("No device type found for '#{device_name}'") if device_type_id.to_s.empty?

      # Newest available iOS runtime, e.g.
      # "com.apple.CoreSimulator.SimRuntime.iOS-26-4".
      runtime_id = `xcrun simctl list runtimes available`
        .lines
        .grep(/com\.apple\.CoreSimulator\.SimRuntime\.iOS-/)
        .map { |line| line[/com\.apple\.CoreSimulator\.SimRuntime\.iOS-[0-9-]+/] }
        .compact
        .max_by { |id| id.split("-").drop(2).map(&:to_i) }
      UI.user_error!("No iOS simulator runtime available") if runtime_id.to_s.empty?

      UI.message("Creating '#{device_name}' (#{device_type_id}, #{runtime_id})")
      udid = `xcrun simctl create "#{device_name}" "#{device_type_id}" "#{runtime_id}"`.strip
      UI.user_error!("Failed to create simulator '#{device_name}'") if udid.to_s.empty?
      UI.success("Created simulator '#{device_name}' (UDID #{udid})")
    else
      UI.message("Simulator '#{device_name}' already available")
    end
  end

  desc "Capture App Store screenshots by driving the app through XCUITest"
  desc "Requires SCREENSHOT_EMAIL and SCREENSHOT_PASSWORD (demo driver account)."
  lane :screenshots do
    email = ENV["SCREENSHOT_EMAIL"].to_s
    password = ENV["SCREENSHOT_PASSWORD"].to_s
    UI.user_error!("SCREENSHOT_EMAIL must be set (demo driver account)") if email.empty?
    UI.user_error!("SCREENSHOT_PASSWORD must be set (demo driver account)") if password.empty?

    ensure_screenshot_device

    # The test runs inside the simulator, in a different process tree to
    # fastlane, and xcodebuild does not forward arbitrary host environment
    # variables into it. Since Xcode 13 it forwards exactly those prefixed with
    # TEST_RUNNER_, stripping the prefix on the way in — so the test still
    # reads SCREENSHOT_EMAIL / SCREENSHOT_PASSWORD. Without this the
    # credentials are simply empty inside the test and it fails its first
    # assertion.
    ENV["TEST_RUNNER_SCREENSHOT_EMAIL"] = email
    ENV["TEST_RUNNER_SCREENSHOT_PASSWORD"] = password

    # fastlane's SnapshotHelper reads SIMULATOR_HOST_HOME and
    # SIMULATOR_DEVICE_NAME to locate the host's screenshot cache, but
    # xcodebuild (Xcode 13+) only forwards TEST_RUNNER_-prefixed variables into
    # the test runner (prefix stripped on the way in). Without these the helper
    # silently no-ops (its guard returns early) and the screenshots artifact
    # comes back empty even though every test passes.
    ENV["TEST_RUNNER_SIMULATOR_HOST_HOME"] = Dir.home
    ENV["TEST_RUNNER_SIMULATOR_DEVICE_NAME"] = ENV["SNAPSHOT_DEVICE"] || "iPhone 17 Pro Max"

    snapshot
  end

  desc "Bump the marketing version and build the App Store IPA"
  desc "Options: bump:patch|minor|major (default patch) or version:x.y.z"
  desc "Writes the resolved version to build/version.txt so a later publish"
  desc "step can pick it up without re-deriving it."
  lane :build_release do |options|
    api_key = asc_api_key

    new_version = apply_version_bump(options)
    prepare_signing(api_key: api_key)
    bump_build_number(api_key: api_key)
    build_release_ipa

    # Anchored on the Fastfile's own location so it lands in <repo>/build
    # regardless of where fastlane was invoked from.
    version_file = File.expand_path("../build/version.txt", __dir__)
    FileUtils.mkdir_p(File.dirname(version_file))
    File.write(version_file, new_version)

    UI.success("Built version #{new_version}")
    new_version
  end

  desc "Upload an already-built IPA and screenshots, submit for review and tag"
  desc "Options: version:x.y.z (required), submit_for_review:true|false,"
  desc "ipa:path (defaults to build/fti_coach.ipa)"
  lane :publish do |options|
    api_key = asc_api_key
    version = options[:version].to_s
    UI.user_error!("publish requires version:x.y.z") if version.empty?
    submit_for_review = options[:submit_for_review].to_s != "false"

    # Re-apply the version here rather than carrying the modified project
    # across from the build: on a clean checkout this makes the release commit
    # contain only the version bump.
    increment_version_number_in_xcodeproj(
      xcodeproj: XCODEPROJ,
      version_number: version,
      target: TARGET,
    )

    # Attach the build to a new App Store version, upload the screenshots and
    # submit for review. Metadata (description, keywords, ...) is managed
    # directly in App Store Connect.
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version,
      ipa: options[:ipa] || "build/fti_coach.ipa",
      skip_metadata: true,
      # CI is non-interactive: without `force` deliver stops to ask about the
      # generated Preview.html before uploading.
      force: true,
      screenshots_path: "fastlane/screenshots",
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: submit_for_review,
      automatic_release: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )

    tag_release(version: version)
  end

  desc "Bump the marketing version, build, upload and submit for App Store review"
  desc "Options: bump:patch|minor|major (default patch) or version:x.y.z"
  desc "Options: submit_for_review:true|false (default true)"
  desc ""
  desc "Runs the whole pipeline sequentially. CI splits this into the"
  desc "build_release / screenshots / publish lanes so the two builds (device"
  desc "archive and simulator screenshot run) happen on parallel machines."
  lane :release do |options|
    new_version = build_release(options)
    screenshots
    publish(
      version: new_version,
      submit_for_review: options[:submit_for_review],
    )
  end
end
