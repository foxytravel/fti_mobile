# Fastfile for FTI Coach
#
# Lanes:
#   fastlane ios beta     - bump build number, build, upload to TestFlight
#   fastlane ios release  - bump marketing version, build, upload and submit
#                           for App Store review
#
# Required environment variables (set as GitHub Actions secrets in CI):
#   ASC_KEY_ID                    App Store Connect API key ID
#   ASC_ISSUER_ID                 App Store Connect API issuer ID
#   ASC_KEY_CONTENT               Contents of the .p8 API key file
#   MATCH_PASSWORD                Passphrase used to encrypt the match repo
#
# The certificates repo is cloned over SSH; in CI a read-only deploy key is
# loaded into ssh-agent by the workflows before fastlane runs.

default_platform(:ios)

APP_IDENTIFIER = "com.foxytravel.fticoach"
TEAM_ID = "97H8939ZRR"
XCODEPROJ = "ios/fti_coach.xcodeproj"
WORKSPACE = "ios/fti_coach.xcworkspace"
SCHEME = "fti_coach"
TARGET = "fti_coach"

platform :ios do
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
    )
  end

  # Fetches signing certs/profiles from the match repo and switches the
  # project to manual signing with the fetched profile.
  private_lane :prepare_signing do |options|
    setup_ci if is_ci

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: is_ci,
      api_key: options[:api_key],
    )

    profile_name =
      lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_IDENTIFIER]

    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: TEAM_ID,
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: [TARGET],
    )
  end

  # Sets the build number to (latest TestFlight build number + 1) so every CI
  # run produces a strictly increasing build number without requiring commits.
  private_lane :bump_build_number do |options|
    latest = latest_testflight_build_number(
      api_key: options[:api_key],
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 18,
    )
    increment_build_number_in_xcodeproj(
      xcodeproj: XCODEPROJ,
      build_number: (latest + 1).to_s,
      target: TARGET,
    )
  end

  private_lane :build_release_ipa do
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      output_directory: "build",
      output_name: "fti_coach.ipa",
    )
  end

  desc "Build the app and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key
    prepare_signing(api_key: api_key)
    bump_build_number(api_key: api_key)
    build_release_ipa

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Bump the marketing version, build, upload and submit for App Store review"
  desc "Options: bump:patch|minor|major (default patch) or version:x.y.z"
  lane :release do |options|
    api_key = asc_api_key

    # 1. Bump the marketing version (unless an explicit version is given).
    if options[:version] && !options[:version].empty?
      increment_version_number_in_xcodeproj(
        xcodeproj: XCODEPROJ,
        version_number: options[:version],
        target: TARGET,
      )
    else
      increment_version_number_in_xcodeproj(
        xcodeproj: XCODEPROJ,
        bump_type: options[:bump] || "patch",
        target: TARGET,
      )
    end
    new_version = get_version_number_from_xcodeproj(
      xcodeproj: XCODEPROJ,
      target: TARGET,
    )

    # 2. Build and upload.
    prepare_signing(api_key: api_key)
    bump_build_number(api_key: api_key)
    build_release_ipa

    # 3. Upload the build, attach it to a new App Store version and submit it
    #    for review. Metadata/screenshots are managed directly in App Store
    #    Connect, so they are skipped here.
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: new_version,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: true,
      automatic_release: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )

    # 4. Commit the version bump back to the repository and tag it.
    if is_ci
      sh("git", "config", "user.name", "github-actions[bot]")
      sh("git", "config", "user.email", "github-actions[bot]@users.noreply.github.com")
    end
    sh("git", "add", "../#{XCODEPROJ}/project.pbxproj")
    sh("git", "commit", "-m", "chore: release v#{new_version} [skip ci]")
    add_git_tag(tag: "v#{new_version}")
    push_to_git_remote(tags: true)
  end
end
