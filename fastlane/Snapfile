# Configuration for `fastlane ios screenshots` (fastlane snapshot).
#
# Screenshots are captured on the largest iPhone (6.9"), which is the display
# size App Store Connect requires. If the simulator name differs on your Xcode
# version, override it via the SNAPSHOT_DEVICE environment variable. The
# `screenshots` lane auto-creates the device if it is missing (fresh Xcode
# installs and GitHub runners do not reliably ship every iPhone simulator).

# The build configuration used for tests comes from the shared scheme's Test
# action, which is set to Release so the JS bundle is embedded (Debug builds
# expect a Metro dev server that isn't running in CI). This key is kept in
# sync for documentation purposes.
configuration("Release")

devices([ENV["SNAPSHOT_DEVICE"] || "iPhone 17 Pro Max"])

languages(["en-US"])

output_directory("fastlane/screenshots")
clear_previous_screenshots(true)
stop_after_first_error(true)

workspace("ios/fti_coach.xcworkspace")
scheme("fti_coach")

# Simulator builds are never signed, so signing is pure overhead here (and
# would fail outright if the project is left on manual signing). dSYMs and the
# index store are equally useless for a screenshot run and cost minutes.
xcargs([
  "CODE_SIGNING_ALLOWED=NO",
  "CODE_SIGNING_REQUIRED=NO",
  "DEBUG_INFORMATION_FORMAT=dwarf",
  "COMPILER_INDEX_STORE_ENABLE=NO",
].join(" "))
