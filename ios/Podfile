# The app has not been migrated to the New Architecture yet: several of its
# native dependencies (react-native-push-notification, react-native-blob-util,
# etc.) are Legacy Architecture modules. RN 0.81 is the last release that
# supports opting out.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve('#{script}', {paths: [process.argv[1]]})", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Only the location permission handler is compiled in; it is the only
# permission requested through react-native-permissions (Components/TodaysOrder.js).
# Camera / photo library prompts are raised natively by react-native-image-crop-picker
# and notification permission by @react-native-community/push-notification-ios.
setup_permissions([
  'LocationWhenInUse',
])

# react-native-firebase v15+ requires static frameworks because the Firebase
# iOS SDK is written in Swift.
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

target 'fti_coach' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix: the {fmt} version vendored by RCT-Folly uses FMT_STRING which
    # produces consteval constructors. Clang 17 (Xcode 26) rejects these as
    # "call to consteval function is not a constant expression" when the call
    # site is not itself a constant expression.
    # Replacing 'consteval' with 'constexpr' in the vendored fmt source files
    # is the reliable fix: constexpr still enables compile-time evaluation
    # where possible, satisfying fmt's format-string checking, but does not
    # mandate it the way consteval does.
    fmt_dir = "#{installer.sandbox.root}/fmt"
    if Dir.exist?(fmt_dir)
      Dir.glob("#{fmt_dir}/**/*.{h,cc}").each do |file|
        next if File.directory?(file)
        content = File.read(file)
        next unless content.include?('consteval')
        # The pod source is extracted read-only, so make it writable first.
        File.chmod(0o644, file)
        File.write(file, content.gsub(/\bconsteval\b/, 'constexpr'))
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        # Silence deployment-target warnings from pods that declare iOS < 13.4.
        if cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 13.4
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.4'
        end

        # Xcode 26 enables explicitly-built modules by default, which is
        # incompatible with how CocoaPods 1.15.2 builds its aggregate target and
        # with RN's ccache compiler wrapper: the build system cannot recognise
        # the compiler ("Explicit modules is enabled but the compiler was not
        # recognized") and the Pods-fti_coach aggregate library is never
        # produced, failing the link with "ld: library 'Pods-fti_coach' not
        # found". Disable explicit modules for the pods, as the clang note
        # itself prescribes (CLANG_ENABLE_EXPLICIT_MODULES=NO).
        cfg.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        cfg.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'

        # Keep ccache on CC/CXX (compile cache) but stop wrapping the linker:
        # RN's post_install sets LD/LDPLUSPLUS to the ccache-clang wrapper,
        # which cannot cache the link step and, driven as LD, breaks the link
        # with "ld: library 'Pods-fti_coach' not found". Deleting the settings
        # reverts linking to Xcode's default clang driver while compiles stay
        # cached.
        cfg.build_settings.delete('LD')
        cfg.build_settings.delete('LDPLUSPLUS')
      end
    end
  end
end
