# The app has not been migrated to the New Architecture yet: several of its
# native dependencies (react-native-push-notification, react-native-blob-util,
# etc.) are Legacy Architecture modules. RN 0.81 is the last release that
# supports opting out.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve('#{script}', {paths: [process.argv[1]]})", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Only the location permission handler is compiled in; it is the only
# permission requested through react-native-permissions (Components/TodaysOrder.js).
# Camera / photo library prompts are raised natively by react-native-image-crop-picker
# and notification permission by @react-native-community/push-notification-ios.
setup_permissions([
  'LocationWhenInUse',
])

# react-native-firebase v15+ requires static frameworks because the Firebase
# iOS SDK is written in Swift.
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

target 'fti_coach' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Fix: the {fmt} version vendored by RCT-Folly uses FMT_STRING / consteval
        # in a way that Clang 17+ (Xcode 26) rejects with
        # "call to consteval function is not a constant expression".
        # Disabling consteval in fmt makes it fall back to a compatible path.
        if target.name == 'fmt'
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] =
            '$(inherited) -DFMT_USE_CONSTEVAL=0'
        end

        # Silence deployment-target warnings from pods that declare iOS < 12.
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.4' \
          if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 13.4
      end
    end
  end
end
